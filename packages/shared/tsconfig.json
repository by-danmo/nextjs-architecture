{
  "extends": "@multi-app/typescript-config/react-library.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "paths": {
      // "@/*": ["./src/*"],
      "@multi-app/lib/*": ["../lib/src/*"],
      "@multi-app/tailwind-config/*": ["../tailwind-config/*"],
    },
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "build"],
}
