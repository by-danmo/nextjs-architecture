{
	"extends": "@prettyfull/typescript-config/nextjs.json",
	"compilerOptions": {
		"outDir": "dist",
		"declaration": true, // This is crucial! It creates the .d.ts files.
		"declarationMap": true,
		"paths": {
			"@/*": ["./src/*"],
			"@prettyfull/utils": ["../../packages/utils/index.ts"],
			"@prettyfull/tailwind-config": [
				"../../packages/tailwind-config/shared.styles.css"
			]
		}
	},

	"include": [
		"src",
		"src/layouts",
		"src/styles.css",
		"../../packages/utils",
		"../../apps/web/src/shared/components/molecules/footer.tsx",
		"../../apps/web/src/shared/components/molecules/header.tsx",
		"../../apps/web/src/components/layout/collection-layout.tsx",
		"../../apps/web/src/components/layout/home-layout.tsx"
	],
	"exclude": ["node_modules", "dist"]
}
