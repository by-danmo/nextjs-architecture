        "@hookform/devtools": "^4.3.1",
        "@hookform/resolvers": "^3.9.0",
        "@tanstack/react-query": "^5.61.4",
        "@types/jsonwebtoken": "^9.0.9",
        "axios": "^1.7.7",
        "chalk": "^5.3.0",
        "class-variance-authority": "^0.7.0",
        "jsonwebtoken": "^9.0.2",
        "lucide-react": "^0.545.0",
        "motion": "^12.4.7",
        "next": "16.2.1",
        "postcss": "^8.5.6",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-hook-form": "^7.53.0",
        "sonner": "^2.0.3",
        "tailwindcss": "^4.1.14",
        "zod": "^3.23.8",
        "zustand": "^5.0.3"
