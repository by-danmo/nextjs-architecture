{
    "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "trailingCommas": "none"
        }
    },
    "files": {
        "ignore": [".next", "node_modules", "public"]
    }
}
